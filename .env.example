# ============================================================
# SantaraBaru Roleplay - Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ============================================================

# MySQL Configuration
MYSQL_ROOT_PASSWORD=ganti_root_password_disini
MYSQL_DATABASE=santara_rp
MYSQL_USER=santara_user
MYSQL_PASSWORD=ganti_password_disini

# phpMyAdmin
PHPMYADMIN_PORT=8080

# SA-MP Server
SAMP_PORT=7777
RCON_PASSWORD=ganti_rcon_password_disini
SERVER_NAME=SantaraBaru Roleplay

# playit.gg Agent Secret Key
# Dapatkan dari: https://playit.gg → New Agent → Docker → Copy Secret Key
PLAYIT_SECRET=ISI_SECRET_KEY_PLAYIT_DISINI
